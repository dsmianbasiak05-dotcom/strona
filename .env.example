# ------------------------------------------------------------------
# STILL LIVING — zmienne środowiskowe
# Skopiuj do .env.local (lokalnie) lub ustaw w Vercel → Settings → Environment Variables.
# Żadna z poniższych wartości nie trafia do przeglądarki.
# ------------------------------------------------------------------

# Docelowy adres strony (bez ukośnika na końcu), np. https://www.twojadomena.pl
# Używany w adresach kanonicznych, sitemap.xml, robots.txt i Open Graph.
# Na Vercel, gdy pusty, użyty zostanie adres produkcyjny projektu (VERCEL_PROJECT_PRODUCTION_URL).
SITE_URL=

# Kod weryfikacyjny Google Search Console (metoda „tag HTML” — sama wartość content).
GOOGLE_SITE_VERIFICATION=

# --- Formularz kontaktowy (POST /api/contact) ----------------------
# Wybierz JEDEN sposób dostarczania wiadomości. Bez konfiguracji formularz
# uczciwie informuje, że wysyłka nie jest jeszcze aktywna — nic nie jest zapisywane.

# Opcja A: Resend (https://resend.com) — wysyłka e-mailem przez REST API.
RESEND_API_KEY=
# Adres nadawcy w zweryfikowanej domenie, np. "STILL LIVING <formularz@twojadomena.pl>"
CONTACT_FROM_EMAIL=
# Skrzynka, na którą trafiają zapytania.
CONTACT_TO_EMAIL=

# Opcja B: webhook (Make, Zapier, n8n, Google Apps Script…) — JSON z polami formularza.
CONTACT_WEBHOOK_URL=
